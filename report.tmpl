<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Heap retention · pprof mem map</title>
  <style>
    :root{color-scheme:light;--bg:#f5f7fb;--surface:#fff;--surface-raised:#f0f5fb;--line:#d5dfeb;--text:#17283a;--muted:#536578;--growth:#126b4c;--shrink:#a33431;--accent:#2758ad}
    *{box-sizing:border-box}
    body{margin:0;background:radial-gradient(ellipse at 88% -15%,#e3effd 0,transparent 42%),var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    main{max-width:1520px;margin:auto;padding:clamp(1rem,3vw,3rem)}
    .eyebrow{color:var(--growth);font-size:.76rem;font-weight:750;letter-spacing:.17em;text-transform:uppercase}
    h1{font-size:clamp(2rem,4vw,3.5rem);line-height:1.1;letter-spacing:-.04em;margin:.65rem 0 1rem}
    .intro{max-width:68ch;color:var(--muted);margin:0 0 2rem}
    .stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:0 0 2rem}
    .stat{background:linear-gradient(145deg,var(--surface-raised),var(--surface));border:1px solid var(--line);border-radius:16px;padding:1.15rem 1.3rem}
    .stat dt{color:var(--muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.09em}
    .stat dd{margin:.3rem 0 0;font-size:clamp(1.5rem,2.6vw,2rem);font-weight:700;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:1.8rem 0 1rem}
    h2{font-size:1.2rem;letter-spacing:-.02em;margin:0}
    .section-head p,.muted{color:var(--muted);margin:.2rem 0 0;font-size:.88rem}
    .search{display:grid;gap:.3rem;font-size:.8rem;color:var(--muted)}
    .search input{width:min(23rem,80vw);padding:.65rem .85rem;background:var(--surface);border:1px solid var(--line);border-radius:10px;color:var(--text);font:inherit}
    .search input:focus-visible,summary:focus-visible,.table-scroll:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    .legend{display:flex;gap:.5rem;flex-wrap:wrap;margin:0 0 1rem}
    .legend span{border:1px solid var(--line);border-radius:999px;padding:.25rem .7rem;font-size:.8rem;color:var(--text)}
    .legend .growth{border-color:#9bcead;color:var(--growth)}.legend .shrinkage{border-color:#e2a5a0;color:var(--shrink)}
    .scroll-hint{display:none;color:var(--muted);font-size:.8rem;margin:0 0 .6rem}
    .table-scroll{overflow:auto;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
    table{width:100%;min-width:750px;border-spacing:0;border-collapse:separate;font-variant-numeric:tabular-nums}
    caption{padding:.9rem 1.2rem;text-align:left;color:var(--muted);font-size:.83rem;border-bottom:1px solid var(--line)}
    th,td{padding:.9rem 1.2rem;border-bottom:1px solid var(--line);vertical-align:top}
    thead th{position:sticky;top:0;z-index:2;background:#eaf0f7;color:var(--muted);font-size:.78rem;letter-spacing:.04em;text-align:right;white-space:nowrap}
    thead th:first-child{left:0;z-index:3;text-align:left}
    tbody th{position:sticky;left:0;z-index:1;min-width:300px;max-width:430px;text-align:left;background:var(--surface);font-weight:500}
    tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}
    tbody tr:hover th,tbody tr:hover td{background-color:#eef4fc}
    td{text-align:right;min-width:185px;white-space:nowrap}
    .site-title{display:block;font-weight:650;color:var(--text);overflow-wrap:anywhere}
    summary{cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}
    summary::before{content:"▸";color:var(--accent);margin-right:.5rem}details[open] summary::before{content:"▾"}
    .call-tree{list-style:none;border-left:1px solid var(--line);margin:1rem 0;padding:0 0 0 1rem;font: .76rem/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}
    .call-tree li{position:relative;margin:0;padding:.35rem 0;overflow-wrap:anywhere}
    .call-tree li::before{content:"";position:absolute;left:-1.27rem;top:.8rem;width:6px;height:6px;border-radius:50%;background:#9aabc0}
    .call-tree li:last-child::before{background:var(--growth)}
    .call-tree code{color:var(--text);font:inherit;font-weight:650}
    .call-tree small{display:block;color:var(--muted);font-size:.95em}
    .origin{margin:1rem 0;color:var(--muted);font-size:.76rem}
    .origin summary{display:inline-block}.origin code{display:block;overflow-wrap:anywhere;font-size:.74rem;margin:.3rem 0}
    .site-details{color:var(--muted);font-size:.8rem;font-weight:400;margin:.65rem 0 0}
    .amount{display:block;font-size:.96rem;font-weight:700}
    .delta{display:block;font-size:.78rem;margin-top:.12rem}
    td.growth{background:#e3f5ea;color:var(--growth)}td.shrinkage{background:#fde9e5;color:var(--shrink)}
    td.no-change{background:#f1f5f9;color:var(--text)}td.unknown{color:var(--muted)}
    .meter{display:block;height:3px;margin-top:.8rem;background:#142b4426;border-radius:8px;overflow:hidden}
    .meter span{display:block;height:100%;background:currentColor;border-radius:8px}
    [hidden]{display:none!important}
    .warnings{padding:1rem 1.25rem;border:1px solid #e2a5a0;border-radius:12px;background:#fff0ec;margin-bottom:1.5rem}
    .warnings h2{color:var(--shrink)}.warnings ul{margin:.5rem 0 0;padding-left:1.25rem;overflow-wrap:anywhere}
    .footnote{color:var(--muted);font-size:.82rem;max-width:90ch;margin:1.5rem 0 0}
    @media (max-width: 760px){.stat-grid{grid-template-columns:1fr 1fr}.stat:last-child{grid-column:1/-1}main{padding:1.1rem}tbody th{min-width:210px;max-width:250px}th,td{padding:.75rem}.section-head{align-items:start}.scroll-hint{display:block}}
    @media (prefers-reduced-motion:no-preference){.search input{transition:border-color .15s}.search input:focus{border-color:var(--accent)}}
  </style>
</head>
<body>
<main>
  <header>
    <div class="eyebrow">pprof / memory analysis</div>
    <h1>Heap retention</h1>
    <p class="intro">Estimated retained memory and allocation churn by allocation site. Compare snapshots to find growth, shrinkage, and stable estimates.</p>
  </header>

  <dl class="stat-grid">
    <div class="stat"><dt>Snapshots</dt><dd>{{len .Snapshots}}</dd></div>
    <div class="stat"><dt>Allocation sites</dt><dd>{{.Total}}</dd></div>
    <div class="stat"><dt>Warnings</dt><dd>{{len .Warnings}}</dd></div>
  </dl>

  {{if .Warnings}}<section class="warnings" aria-labelledby="warning-title"><h2 id="warning-title">Warnings</h2><ul>{{range .Warnings}}<li>{{.}}</li>{{end}}</ul></section>{{end}}

  <section aria-labelledby="heatmap-title">
    <div class="section-head">
      <div><h2 id="heatmap-title">Retained memory heatmap</h2><p>Binary units (KiB, MiB) · sorted by {{.Sort}}</p></div>
      <label class="search" id="search-control" hidden>Filter displayed sites<input id="site-search" type="search" placeholder="Function or stack frame" autocomplete="off"></label>
    </div>
    <div class="legend" aria-label="Change legend">Change from previous snapshot:
      <span class="growth">growth (+)</span><span class="shrinkage">shrinkage (-)</span><span class="no-change">no change (0)</span><span class="unknown">unknown / baseline</span>
    </div>
    <p class="scroll-hint">Scroll sideways to compare snapshots</p>
    <div class="table-scroll" role="region" aria-label="Retained memory by allocation site" tabindex="0">
      <table id="sites">
        <caption id="site-count" aria-live="polite">Retained memory; showing {{len .Sites}} of {{.Total}} sites.</caption>
        <thead><tr><th scope="col">Allocation site</th>{{range $i, $snapshot := .Snapshots}}<th scope="col">Snapshot {{add $i 1}}<br><span class="muted"><time datetime="{{$snapshot.Time.Format "2006-01-02T15:04:05Z07:00"}}">{{$snapshot.Time.Format "2006-01-02 15:04:05Z07:00"}}</time></span></th>{{end}}</tr></thead>
        <tbody>{{range .Sites}}{{$peak := .PeakBytes}}
          <tr data-search="{{.Stack}}"><th scope="row"><details><summary><span class="site-title">{{siteLabel .Stack}}</span></summary>
            <p class="site-details">Call path: caller to allocation</p>
            <ol class="call-tree">{{range stackFrames .Stack}}<li class="frame" title="{{.Full}}"><code>{{.Name}}</code>{{if .Source}}<small>{{.Source}}</small>{{end}}</li>{{end}}</ol>
            <details class="origin"><summary>Profile identity</summary>{{range stackOrigins .Stack}}<code title="{{.Full}}">{{.Label}}: {{.Value}}</code>{{end}}</details>
            <p class="site-details">Peak retained memory: {{humanBytes .PeakBytes}}<br>Net change: {{humanSigned .NetBytes}} · {{groupedSigned .NetObjects}} objects<br>Allocation churn: {{humanBytes .TotalChurnBytes}}<br>Stable estimate: {{.Stable}}<br>Retained objects: {{range .Points}}{{grouped .RetainedObjects}}; {{end}}</p>
          </details></th>
          {{range $index, $point := .Points}}<td class="{{class .DeltaBytes}}" aria-label="retained memory {{value .RetainedBytes}} bytes; {{label .DeltaBytes}} {{signed .DeltaBytes}} bytes; retained objects {{value .RetainedObjects}}; object change {{signed .DeltaObjects}}; allocation churn {{value .ChurnBytes}} bytes"><span class="amount" title="{{value .RetainedBytes}} bytes">{{humanBytes .RetainedBytes}}</span><span class="delta" title="{{signed .DeltaBytes}} bytes">{{if .DeltaBytes}}{{humanSigned .DeltaBytes}} ({{label .DeltaBytes}}){{else}}{{if eq $index 0}}baseline{{else}}unknown change{{end}}{{end}}</span><span class="meter" aria-hidden="true"><span style="width:{{percent .RetainedBytes $peak}}%"></span></span></td>{{end}}</tr>{{end}}
        </tbody>
      </table>
    </div>
  </section>
  <p class="footnote">Heap profiles contain sampling estimates, not object identity or access frequency. Stable estimates do not prove object survival or inactivity. Allocation churn measures differences in cumulative allocation samples. Bar lengths compare retained memory within each site, not across sites.</p>
</main>
<script>
  const rows = [...document.querySelectorAll('#sites tbody tr')];
  const search = document.querySelector('#site-search');
  const count = document.querySelector('#site-count');
  document.querySelector('#search-control').hidden = false;
  search.addEventListener('input', () => {
    const term = search.value.toLocaleLowerCase().trim();
    let matched = 0;
    rows.forEach(row => {
      row.hidden = !row.dataset.search.toLocaleLowerCase().includes(term);
      if (!row.hidden) matched++;
    });
    count.textContent = `Retained memory; showing ${matched} of ${rows.length} displayed sites. Filter does not include sites outside this report view.`;
  });
</script>
</body>
</html>
